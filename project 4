using System;

class Program
{
    static int CountWord(string text, string word)
    {
        int count = 0;

        for (int i = 0; i <= text.Length - word.Length; i++)
        {
            bool same = true;

            for (int j = 0; j < word.Length; j++)
            {
                if (text[i + j] != word[j])
                {
                    same = false;
                }
            }

            if (same)
            {
                count++;
            }
        }

        return count;
    }

    static void Main()
    {
        string text = "the boy ate  the the the the apple";
        string word = "the";

        Console.WriteLine(CountWord(text, word));
    }
}


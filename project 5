using System;

class Program
{
    static void Main()
    {
        string message = "Theparkisgreatplaceforanoutdoorsummervacation";

        int[] sod = { 3, 4, 2, 5, 5, 3, 2, 6, 6, 8 };

        int position = 0;

        Console.WriteLine(" secret msg");

        for (int i = 0; i < sod.Length; i++)
        {
            string word = message.Substring(position, sod[i]);

            Console.Write(word);

            if (i < sod.Length - 1)
                Console.Write(" ");

            position += sod[i];
        }

        Console.WriteLine();
    }
}

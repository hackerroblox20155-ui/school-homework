using System;

class Program
{
    // دالة ترجع أكبر عدد في المصفوفة
    public static int MaxArray(int[] a)
    {
        int max = a[0];

        for (int i = 1; i < a.Length; i++)
        {
            if (a[i] > max)
                max = a[i];
        }

        return max;
    }

    static void Main()
    {
        Random rnd = new Random();

        int[] a = new int[10];

        // إنشاء 10 أعداد عشوائية من 10 إلى 30
        for (int i = 0; i < a.Length; i++)
        {
            a[i] = rnd.Next(10, 31);
        }

        // طباعة المصفوفة
        Console.WriteLine("array =");
        for (int i = 0; i < a.Length; i++)
        {
            Console.Write(a[i] + " ");
        }

        Console.WriteLine();

        // طباعة أكبر قيمة
        Console.WriteLine("biggest number= " + MaxArray(a));
    }
}
